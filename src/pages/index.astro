---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StoryGlastonCherry from '../components/StoryGlastonCherry.astro';
import StoryDogKennelHill from '../components/StoryDogKennelHill.astro';
import DonateSection from '../components/DonateSection.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en" class="scroll-smooth bg-[#FAF6F0] text-stone-900 antialiased">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/lista-flag.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Love Is Still The Answer. Cooking, Community, Soundsystems, Good times</title>
    <meta 
      name="description" 
      content="Love Is Still The Answer is a nonprofit organization using music, food, bonfires, and bubble machines to create beautiful intergenerational events." 
    />

    <!-- Open Graph tags for social sharing -->
    <meta property="og:title" content="Love Is Still The Answer" />
    <meta property="og:description" content="Creating beautiful intergenerational spaces through music, food & magic." />
    <meta property="og:image" content={`${Astro.url}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A red flag reading Love Is Still The Answer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen flex flex-col font-sans selection:bg-[#EE4223] selection:text-white">
    <Header />
    <main class="grow">
      <Hero />
      <StoryDogKennelHill />
      <StoryGlastonCherry />
      <DonateSection />
    </main>
    <Footer />
  </body>
</html>
