---
---
<section id="stories" class="py-24 bg-[#F5EBE1]/60">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-200/80 text-stone-700 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>Inaugural Fundraiser Event</span>
      </div>
      <h2 class="font-serif text-4xl sm:text-5xl text-stone-900 leading-tight mb-4">
        Dog Kennel Hill Adventure Playground
      </h2>
      <p class="text-stone-700 font-light text-xl leading-relaxed text-pretty">
        Our very first event brought the community together to raise vital funds for Dog Kennel Hill Adventure Playground—a priceless sanctuary for local kids. Entry was free, and through food, drinks, and community donations we demonstrated the power of music and hospitality.
      </p>
    </div>
    <!-- Grid showcasing Event Poster + Video Embed -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Video Embed Frame -->
      <div class="lg:col-span-8">
        <div class="rounded-3xl overflow-hidden bg-stone-900 shadow-xl border border-stone-300/80">
          <div class="relative aspect-video w-full">
            <iframe 
              class="absolute top-0 left-0 w-full h-full" 
              src="https://www.youtube.com/embed/zNbjgIjs-VE?rel=0&cc_load_policy=0&iv_load_policy=3" 
              title="Dog Kennel Hill Adventure Playground Fundraiser - Love is still the answer" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              referrerpolicy="strict-origin-when-cross-origin" 
              allowfullscreen
            ></iframe>
          </div>
        </div>
        <div class="mt-4 text-center lg:text-left">
          <p class="text-sm text-stone-600 font-light italic">
            Video of our inaugural event by Bridie • Music by Kotoa
          </p>
        </div>
      </div>
<!-- Poster Card -->
      <div class="lg:col-span-4">
        <div class="p-1 bg-white rounded-3xl border border-stone-200 shadow-md">
          <img 
            src="/dog-kennel-hill-poster.jpg" 
            alt="Dog Kennel Hill Adventure Playground Fundraiser Poster" 
            class="w-full h-auto rounded-2xl object-cover" 
          />
          <div class="p-4 text-center">
            <!-- <p class="font-serif text-lg text-stone-800">Original Event Poster</p> -->
            <p class="text-xs text-stone-500 font-light mt-1">Poster by sara.pof</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
