---
import { bank } from '../config';

const bankRows = [
  { label: 'Account name', value: bank.accountName },
  { label: 'Sort code', value: bank.sortCode.replace(/(\d{2})(?=\d)/g, '$1-') },
  { label: 'Account number', value: bank.accountNumber },
  { label: 'Reference', value: bank.reference },
];

// One labelled line per field. Apps like Monzo pick the 6-digit sort code and
// 8-digit account number out of pasted text, so keep other long numbers out.
const allDetails = bankRows.map((row) => `${row.label}: ${row.value}`).join('\n');
---
<section id="donate" class="py-24 bg-stone-900 text-stone-100 relative overflow-hidden">
  <!-- Subtle warm gradient glow -->
  <div class="absolute inset-0 bg-gradient-to-tr from-[#DE7440]/20 via-transparent to-[#EE4223]/10 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#EE4223]/20 text-[#FF8A73] text-xs font-semibold uppercase tracking-widest mb-4">
        Support Our Work
      </span>
      <h2 class="font-serif text-5xl sm:text-6xl text-white tracking-tight mb-6">
        Support Love Is Still The Answer
      </h2>
      <p class="text-stone-300 text-lg sm:text-xl font-light leading-relaxed text-pretty">
        Love Is Still The Answer is a non-profit organisation. We create free, inclusive community events powered by music, great food, and fundraising for local charities and schools. Every contribution directly funds equipment, event logistics, and community feasts.
      </p>
    </div>

    <!-- Impact Tiers -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-16">
      <div class="p-6 rounded-2xl bg-stone-800/80 border border-stone-700/80 flex flex-col justify-between">
        <div>
          <span class="font-serif text-3xl text-[#FF8A73] block mb-2">£20</span>
          <h3 class="font-medium text-white text-lg mb-2">Bonfire & Bubbles</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">
            Covers firewood and bubble mixture for a neighbourhood twilight gathering.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-stone-800/80 border border-stone-700/80 flex flex-col justify-between">
        <div>
          <span class="font-serif text-3xl text-[#FF8A73] block mb-2">£100</span>
          <h3 class="font-medium text-white text-lg mb-2">Sound System Transport</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">
            Funds van hire and logistics to bring our sound system stack to a school summer fair.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-stone-800/80 border border-stone-700/80 flex flex-col justify-between">
        <div>
          <span class="font-serif text-3xl text-[#FF8A73] block mb-2">Custom</span>
          <h3 class="font-medium text-white text-lg mb-2">Every Bit Helps</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">
            Any gift, large or small, directly fuels our non-profit community work and equipment.
          </p>
        </div>
      </div>
    </div>

    <!-- Main Donation Card & Options -->
    <div class="p-6 sm:p-12 rounded-3xl bg-stone-800 border border-stone-700 text-center max-w-2xl mx-auto shadow-2xl">
      <h3 class="font-serif text-3xl text-white mb-4">Make a Donation</h3>

      <p class="text-stone-300 text-sm font-light mb-8 max-w-md mx-auto">
        Donate by bank transfer: there are no fees, so every penny goes to the work. Tap a detail to select it, or copy them all at once.
      </p>

      <dl class="text-left divide-y divide-stone-700 rounded-2xl border border-stone-700 bg-stone-900/50">
        {bankRows.map((row) => (
          <div class="px-4 sm:px-5 py-3">
            <dt class="text-xs uppercase tracking-wider text-stone-400">{row.label}</dt>
            <dd class="text-white text-lg tabular-nums tracking-wide break-words select-all">{row.value}</dd>
          </div>
        ))}
      </dl>

      <button
        type="button"
        data-copy={allDetails}
        class="mt-8 px-8 py-4 rounded-full bg-[#EE4223] text-white font-medium text-lg hover:bg-[#D43417] transition-all shadow-lg"
      >
        Copy all details
      </button>
    </div>
  </div>
</section>

<script>
  // Falls back to execCommand where the Clipboard API is unavailable or blocked.
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.append(textarea);
      textarea.select();
      const copied = document.execCommand('copy');
      textarea.remove();
      return copied;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      const copied = await copyText(button.dataset.copy ?? '');
      button.textContent = copied ? 'Copied' : 'Copy failed';
      setTimeout(() => (button.textContent = label), 2000);
    });
  });
</script>
