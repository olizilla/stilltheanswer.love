<section id="donate" class="py-24 bg-stone-900 text-stone-100 relative overflow-hidden">
  <!-- Subtle warm gradient glow -->
  <div class="absolute inset-0 bg-gradient-to-tr from-[#DE7440]/20 via-transparent to-[#EE4223]/10 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#EE4223]/20 text-[#FF8A73] text-xs font-semibold uppercase tracking-widest mb-4">
        Support Our Work
      </span>
      <h2 class="font-serif text-5xl sm:text-6xl text-white tracking-tight mb-6">
        Support Love is still the answer
      </h2>
      <p class="text-stone-300 text-lg sm:text-xl font-light leading-relaxed text-pretty">
        Love is still the answer is a non-profit organisation. We create free, inclusive community events powered by live music, great food, and fundraising for local charities and schools. Every contribution directly funds equipment, event logistics, and community feasts.
      </p>
    </div>

    <!-- Impact Tiers -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-16">
      <div class="p-6 rounded-2xl bg-stone-800/80 border border-stone-700/80 flex flex-col justify-between">
        <div>
          <span class="font-serif text-3xl text-[#FF8A73] block mb-2">£15</span>
          <h3 class="font-medium text-white text-lg mb-2">Bonfire & Bubbles</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">
            Covers firewood and bubble mixture for a neighbourhood twilight gathering.
          </p>
        </div>
      </div>

