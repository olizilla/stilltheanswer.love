---
---
<section class="pt-4 pb-16 overflow-hidden bg-gradient-to-b from-[#FAF6F0] via-[#F6EDE2] to-[#FAF6F0]">
  <div class="max-w-6xl mx-auto px-6 relative z-10">

    <!-- Hero Content: Stacked on small screens (Logo top), Text Left & Flag Right on large screens -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center text-center lg:text-left mb-12">
      
      <!-- Main Copy Column (Left on large screens) -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl tracking-tight text-stone-900 leading-[1.1] text-balance mb-6">
          Creating spaces for all ages with music, food & magic.
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-stone-700 font-light leading-relaxed text-pretty">
          We cook meals, tune sound systems, gather bonfires and bubble machines to make spaces that bring children, elders, and everyone in-between, together.
        </p>
      </div>

      <!-- Logo Flag Column (Above on mobile/tablet, Right on large screens) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end order-1 lg:order-2">
        <div class="w-full max-w-none">
          <img 
            src="/LISTA.svg" 
            alt="Love Is Still The Answer logo" 
            class="w-full h-auto max-h-80 sm:max-h-80 lg:max-h-80 object-contain drop-shadow-sm" 
          />
        </div>
      </div>

    </div>

    <!-- Featured Inaugural Video Embed -->
    <div class="max-w-4xl mx-auto">
      <div class="rounded-3xl overflow-hidden bg-stone-900 shadow-xl border border-stone-300/80">
        <div class="relative aspect-video w-full">
          <iframe 
            class="absolute top-0 left-0 w-full h-full" 
            src="https://www.youtube.com/embed/zNbjgIjs-VE?rel=0&cc_load_policy=0&iv_load_policy=3" 
            title="Dog Kennel Hill Adventure Playground Fundraiser - Love Is Still The Answer" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin" 
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <div class="mt-3 text-center">
        <p class="text-xs text-stone-500 font-light italic">
          Video of our inaugural event by Bridie • Music by Kotoa
        </p>
      </div>
    </div>

  </div>
</section>
